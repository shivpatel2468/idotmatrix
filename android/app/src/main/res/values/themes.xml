<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Before the studio loads, the window already wears the studio's first-run colours (Cyber grid, dark; the
         same in values-night). Once it runs, MainActivity draws edge to edge with transparent bars and applies the
         theme the studio reports (remembered for the next start); see DeskDotAndroid.setBars. -->
    <style name="Theme.DeskDot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/deskdot_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/deskdot_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/deskdot_light_bars</item>
    </style>

    <!-- The launch splash (core-splashscreen; the Android 12+ SplashScreen API, also on older phones): only the page
         colour, no icon, so it hands over to the app's own LED intro (IntroView) without a second logo or a white
         flash. MainActivity removes it at once. -->
    <style name="Theme.DeskDot.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deskdot_page</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_none</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.DeskDot</item>
    </style>
</resources>
